# OpenSSH 7.7_p1-r4 from Alpine 3.8 (package openssh-server=7.7_p1-r4), base pinned by digest. Generated by harness/v2_sweep_one.sh.
FROM alpine@sha256:2bb501e6173d9d006e56de5bce2720eb06396803300fe1687b58a7ff32bf4c14
RUN apk add --no-cache openssh-server=7.7_p1-r4 openssh-keygen=7.7_p1-r4 \
 && adduser -D -s /bin/sh tester && echo 'tester:correct-horse-battery' | chpasswd \
 && ssh-keygen -q -t rsa -b 3072 -N "" -f /etc/ssh/ssh_host_rsa_key && ssh-keygen -q -t ed25519 -N "" -f /etc/ssh/ssh_host_ed25519_key \
 && mkdir -p /run/sshd /home/tester/.ssh && chown tester /home/tester/.ssh && chmod 700 /home/tester/.ssh \
 && printf 'Port 22\nHostKey /etc/ssh/ssh_host_rsa_key\nHostKey /etc/ssh/ssh_host_ed25519_key\nPasswordAuthentication yes\nPubkeyAuthentication yes\nPermitRootLogin no\nMaxStartups 100:30:200\nLogLevel DEBUG3\n\n' > /etc/ssh/sshd_config
CMD ["/usr/sbin/sshd", "-D", "-e"]
