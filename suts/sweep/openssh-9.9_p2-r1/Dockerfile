# OpenSSH 9.9_p2-r1 from Alpine 3.21 (package openssh-server=9.9_p2-r1), base pinned by digest. Generated by harness/v2_sweep_one.sh.
FROM alpine@sha256:87a4361f6c819618a6bafa2ed5228714cb0bb22195d2b49c95eb26799990128a
RUN apk add --no-cache openssh-server=9.9_p2-r1 openssh-keygen=9.9_p2-r1 \
 && adduser -D -s /bin/sh tester && echo 'tester:correct-horse-battery' | chpasswd \
 && ssh-keygen -q -t rsa -b 3072 -N "" -f /etc/ssh/ssh_host_rsa_key && ssh-keygen -q -t ed25519 -N "" -f /etc/ssh/ssh_host_ed25519_key \
 && mkdir -p /run/sshd /home/tester/.ssh && chown tester /home/tester/.ssh && chmod 700 /home/tester/.ssh \
 && printf 'Port 22\nHostKey /etc/ssh/ssh_host_rsa_key\nHostKey /etc/ssh/ssh_host_ed25519_key\nPasswordAuthentication yes\nPubkeyAuthentication yes\nPermitRootLogin no\nMaxStartups 100:30:200\nLogLevel DEBUG3\nPerSourcePenalties no\n' > /etc/ssh/sshd_config
CMD ["/usr/sbin/sshd", "-D", "-e"]
